# ==============================================================================
# IoT Smart Soil Analysis — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to GitHub. Add it to .gitignore.
#
# HOW TO SET IN TERMINAL (macOS/Linux):
#   export GOOGLE_WEATHER_API_KEY="YOUR_ACTUAL_KEY"
#   export DEVICE_TOKEN="your-secret-iot-token"
#   python app.py
#
# Or use a shell script (start_server.sh) — see README for instructions.
# ==============================================================================

# Google Maps Platform Weather API key
# Get it from: https://console.cloud.google.com/
# Enable: "Weather API" under APIs & Services
# Required for GET /api/weather to return real data.
# Leave blank to get a 503 error with clear instructions.
GOOGLE_WEATHER_API_KEY=

# IoT Device Bearer Token
# Must match the token sent in the Authorization header by your ESP32 or simulator.
# Default (used when not set): iot-dev-token-change-me
# CHANGE THIS before deploying to production or any public network.
DEVICE_TOKEN=iot-dev-token-change-me
